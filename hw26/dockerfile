# Використовуємо офіційний легковаговий образ Node.js
FROM node:18-alpine

# Створюємо робочу директорію
WORKDIR /app

# Копіюємо файли залежностей та встановлюємо їх
COPY package*.json ./
RUN npm install --production

# Копіюємо решту файлів проекту
COPY . .

# Відкриваємо порт, який використовує застосунок (зазвичай 3000 або 8080)
EXPOSE 3000

# Запуск застосунку
CMD ["node", "index.js"]
